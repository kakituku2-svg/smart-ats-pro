; WILD CATCH — Godot 4.7.x production prototype
config_version=5

[application]
config/name="WILD CATCH"
run/main_scene="res://scenes/ui/title_screen.tscn"

[autoload]
GameState="*res://autoload/game_state.gd"
SaveManager="*res://autoload/save_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
SettingsManager="*res://autoload/settings_manager.gd"
MissionRouter="*res://autoload/mission_router.gd"
MissionStageFlowRuntime="*res://autoload/mission_stage_flow_runtime.gd"
InterferenceRuntime="*res://autoload/interference_runtime.gd"
InterferenceArtRuntime="*res://autoload/interference_art_runtime.gd"
StageMimoIdentityRuntime="*res://autoload/stage_mimo_identity_runtime.gd"
MissionAmbientRuntime="*res://autoload/mission_ambient_runtime.gd"
MissionHazardRuntime="*res://autoload/mission_hazard_runtime.gd"
MissionPropRuntime="*res://autoload/mission_prop_runtime.gd"
MissionSignatureRuntime="*res://autoload/mission_signature_runtime.gd"
MissionEnvironmentArtRuntime="*res://autoload/mission_environment_art_runtime.gd"
HubArtRuntime="*res://autoload/hub_art_runtime.gd"
HubEnvironmentArtRuntime="*res://autoload/hub_environment_art_runtime.gd"
HubControlsRuntime="*res://autoload/hub_controls_runtime.gd"
HubStatsRuntime="*res://autoload/hub_stats_runtime.gd"
GlobalPauseMenu="*res://scripts/ui/pause_menu.gd"
AchievementOverlay="*res://autoload/achievement_overlay.gd"
VitalsOverlay="*res://autoload/vitals_overlay.gd"
FieldLogModal="*res://autoload/field_log_modal.gd"
StageArtRuntime="*res://autoload/stage_art_runtime.gd"
CheckpointRuntime="*res://autoload/checkpoint_runtime.gd"
PerformanceRuntime="*res://autoload/performance_runtime.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true

[input_devices]
pointing/emulate_mouse_from_touch=true

[input]
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
dash={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
net={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1),Object(InputEventKey,"physical_keycode":69)]}
scan={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81)]}
lure={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":49)]}
pulse={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":50)]}
drone={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":51)]}
field_log={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70)]}
pause_game={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305),Object(InputEventKey,"physical_keycode":80)]}
